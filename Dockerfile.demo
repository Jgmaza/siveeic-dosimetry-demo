FROM node:14.21.3-bullseye AS build

RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends python3 python-is-python3 make g++; \
	rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN npm install -g @angular/cli@7.3.10
COPY package*.json ./
RUN npm ci
COPY . .
RUN ng build --aot --configuration=prod

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY ./nginx/demo/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
