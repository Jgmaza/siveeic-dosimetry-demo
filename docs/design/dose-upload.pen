{
  "version": "2.20",
  "variables": {
    "color/background": { "type": "color", "value": "#F4F7F6" },
    "color/surface": { "type": "color", "value": "#FFFFFF" },
    "color/ink": { "type": "color", "value": "#14212B" },
    "color/muted": { "type": "color", "value": "#4A5D6A" },
    "color/line": { "type": "color", "value": "#C5D0D6" },
    "color/accent": { "type": "color", "value": "#0D5C63" },
    "color/accent-soft": { "type": "color", "value": "#D4E8EA" },
    "color/danger": { "type": "color", "value": "#B42318" },
    "color/success": { "type": "color", "value": "#067647" },
    "font/display": { "type": "string", "value": "Fraunces" },
    "font/sans": { "type": "string", "value": "Geist Sans" },
    "font/mono": { "type": "string", "value": "Geist Mono" }
  },
  "children": [
    {
      "type": "frame",
      "id": "upIdle",
      "x": 0,
      "y": 0,
      "name": "Upload — Idle",
      "clip": true,
      "width": 1200,
      "height": 820,
      "fill": "$color/background",
      "layout": "vertical",
      "gap": 24,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "t1",
          "name": "Eyebrow",
          "fill": "$color/accent",
          "content": "DOSE LEDGER · MASS LOAD",
          "fontFamily": "$font/mono",
          "fontSize": 11,
          "fontWeight": "500"
        },
        {
          "type": "text",
          "id": "t2",
          "name": "Title",
          "fill": "$color/ink",
          "content": "Carga dosimétrica por Excel",
          "fontFamily": "$font/display",
          "fontSize": 36,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "t3",
          "name": "Subtitle",
          "fill": "$color/muted",
          "content": "Valida el archivo, revisa errores y confirma la carga al ledger unificado. Datos ficticios — demo sanitizada.",
          "fontFamily": "$font/sans",
          "fontSize": 15
        },
        {
          "type": "frame",
          "id": "card1",
          "name": "Upload card",
          "width": "fill_container",
          "height": 420,
          "fill": "$color/surface",
          "stroke": "$color/line",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 20,
          "padding": 28,
          "children": [
            {
              "type": "frame",
              "id": "periodRow",
              "name": "Period row",
              "width": "fill_container",
              "height": 56,
              "layout": "horizontal",
              "gap": 16,
              "children": [
                {
                  "type": "frame",
                  "id": "periodField",
                  "name": "Period field",
                  "width": 200,
                  "height": 56,
                  "fill": "$color/surface",
                  "stroke": "$color/line",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "padding": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "pl",
                      "fill": "$color/muted",
                      "content": "PERIODO (AÑO)",
                      "fontFamily": "$font/mono",
                      "fontSize": 10
                    },
                    {
                      "type": "text",
                      "id": "pv",
                      "fill": "$color/ink",
                      "content": "2025",
                      "fontFamily": "$font/sans",
                      "fontSize": 15
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "drop",
              "name": "Dropzone",
              "width": "fill_container",
              "height": 180,
              "fill": "$color/accent-soft",
              "stroke": "$color/accent",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": 32,
              "children": [
                {
                  "type": "text",
                  "id": "dz1",
                  "fill": "$color/ink",
                  "content": "Arrastra el Excel o haz clic para seleccionar",
                  "fontFamily": "$font/sans",
                  "fontSize": 16,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "dz2",
                  "fill": "$color/muted",
                  "content": ".xlsx · .xls · .csv  ·  plantilla demo incluida",
                  "fontFamily": "$font/mono",
                  "fontSize": 11
                }
              ]
            },
            {
              "type": "frame",
              "id": "actionsIdle",
              "name": "Actions",
              "width": "fill_container",
              "height": 44,
              "layout": "horizontal",
              "gap": 12,
              "children": [
                {
                  "type": "frame",
                  "id": "btnValidate",
                  "name": "Validate btn",
                  "width": 160,
                  "height": 40,
                  "fill": "$color/accent",
                  "layout": "horizontal",
                  "padding": [10, 16],
                  "children": [
                    {
                      "type": "text",
                      "id": "bv",
                      "fill": "#F4F7F6",
                      "content": "Validar archivo",
                      "fontFamily": "$font/sans",
                      "fontSize": 14
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "upValid",
      "x": 1280,
      "y": 0,
      "name": "Upload — Validated",
      "clip": true,
      "width": 1200,
      "height": 820,
      "fill": "$color/background",
      "layout": "vertical",
      "gap": 24,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "vtitle",
          "fill": "$color/ink",
          "content": "Validación completa",
          "fontFamily": "$font/display",
          "fontSize": 32,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "stats",
          "name": "Stats row",
          "width": "fill_container",
          "height": 100,
          "layout": "horizontal",
          "gap": 16,
          "children": [
            {
              "type": "frame",
              "id": "s1",
              "width": 200,
              "height": 100,
              "fill": "$color/surface",
              "stroke": "$color/line",
              "strokeWidth": 1,
              "layout": "vertical",
              "padding": 16,
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "s1l",
                  "fill": "$color/muted",
                  "content": "FILAS",
                  "fontFamily": "$font/mono",
                  "fontSize": 10
                },
                {
                  "type": "text",
                  "id": "s1v",
                  "fill": "$color/ink",
                  "content": "128",
                  "fontFamily": "$font/display",
                  "fontSize": 28
                }
              ]
            },
            {
              "type": "frame",
              "id": "s2",
              "width": 200,
              "height": 100,
              "fill": "$color/surface",
              "stroke": "$color/line",
              "strokeWidth": 1,
              "layout": "vertical",
              "padding": 16,
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "s2l",
                  "fill": "$color/muted",
                  "content": "OK",
                  "fontFamily": "$font/mono",
                  "fontSize": 10
                },
                {
                  "type": "text",
                  "id": "s2v",
                  "fill": "$color/success",
                  "content": "121",
                  "fontFamily": "$font/display",
                  "fontSize": 28
                }
              ]
            },
            {
              "type": "frame",
              "id": "s3",
              "width": 200,
              "height": 100,
              "fill": "$color/surface",
              "stroke": "$color/line",
              "strokeWidth": 1,
              "layout": "vertical",
              "padding": 16,
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "s3l",
                  "fill": "$color/muted",
                  "content": "ERRORES",
                  "fontFamily": "$font/mono",
                  "fontSize": 10
                },
                {
                  "type": "text",
                  "id": "s3v",
                  "fill": "$color/danger",
                  "content": "7",
                  "fontFamily": "$font/display",
                  "fontSize": 28
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "errTable",
          "name": "Error summary",
          "width": "fill_container",
          "height": 220,
          "fill": "$color/surface",
          "stroke": "$color/line",
          "strokeWidth": 1,
          "layout": "vertical",
          "padding": 20,
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "et",
              "fill": "$color/ink",
              "content": "Resumen de errores (filas omitidas al confirmar)",
              "fontFamily": "$font/sans",
              "fontSize": 14,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "er1",
              "fill": "$color/muted",
              "content": "Fila 12 · documento vacío",
              "fontFamily": "$font/mono",
              "fontSize": 12
            },
            {
              "type": "text",
              "id": "er2",
              "fill": "$color/muted",
              "content": "Fila 28 · dosis mes 3 no numérica",
              "fontFamily": "$font/mono",
              "fontSize": 12
            },
            {
              "type": "text",
              "id": "er3",
              "fill": "$color/muted",
              "content": "Fila 41 · operador no reconocido",
              "fontFamily": "$font/mono",
              "fontSize": 12
            }
          ]
        },
        {
          "type": "frame",
          "id": "confirmRow",
          "width": "fill_container",
          "height": 44,
          "layout": "horizontal",
          "gap": 12,
          "children": [
            {
              "type": "frame",
              "id": "btnCommit",
              "width": 200,
              "height": 40,
              "fill": "$color/accent",
              "layout": "horizontal",
              "padding": [10, 16],
              "children": [
                {
                  "type": "text",
                  "id": "bc",
                  "fill": "#F4F7F6",
                  "content": "Confirmar carga (121)",
                  "fontFamily": "$font/sans",
                  "fontSize": 14
                }
              ]
            },
            {
              "type": "frame",
              "id": "btnErr",
              "width": 200,
              "height": 40,
              "fill": "$color/surface",
              "stroke": "$color/line",
              "strokeWidth": 1,
              "layout": "horizontal",
              "padding": [10, 16],
              "children": [
                {
                  "type": "text",
                  "id": "be",
                  "fill": "$color/ink",
                  "content": "Descargar errores",
                  "fontFamily": "$font/sans",
                  "fontSize": 14
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "upDone",
      "x": 2560,
      "y": 0,
      "name": "Upload — Completed",
      "clip": true,
      "width": 1200,
      "height": 820,
      "fill": "$color/background",
      "layout": "vertical",
      "gap": 24,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "doneTitle",
          "fill": "$color/ink",
          "content": "Carga confirmada",
          "fontFamily": "$font/display",
          "fontSize": 36,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "doneBody",
          "fill": "$color/muted",
          "content": "121 registros insertados en el ledger unificado (fuente NUEVO). Dual-write mock: histórico intacto.",
          "fontFamily": "$font/sans",
          "fontSize": 15
        },
        {
          "type": "frame",
          "id": "doneActions",
          "width": "fill_container",
          "height": 44,
          "layout": "horizontal",
          "gap": 12,
          "children": [
            {
              "type": "frame",
              "id": "btnLedger",
              "width": 180,
              "height": 40,
              "fill": "$color/accent",
              "layout": "horizontal",
              "padding": [10, 16],
              "children": [
                {
                  "type": "text",
                  "id": "bl",
                  "fill": "#F4F7F6",
                  "content": "Ver ledger",
                  "fontFamily": "$font/sans",
                  "fontSize": 14
                }
              ]
            },
            {
              "type": "frame",
              "id": "btnAgain",
              "width": 180,
              "height": 40,
              "fill": "$color/surface",
              "stroke": "$color/line",
              "strokeWidth": 1,
              "layout": "horizontal",
              "padding": [10, 16],
              "children": [
                {
                  "type": "text",
                  "id": "ba",
                  "fill": "$color/ink",
                  "content": "Nueva carga",
                  "fontFamily": "$font/sans",
                  "fontSize": 14
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
